generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Zone {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Zone A"
  level     String   // e.g., "Level 1"
  capacity  Int
  slots     Slot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Slot {
  id        String   @id // e.g., "A01"
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id])
  status    String   @default("available") // "available", "occupied", "reserved", "disabled"
  sessions  Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String    @id @default(cuid())
  slotId    String?
  slot      Slot?     @relation(fields: [slotId], references: [id])
  plate     String    // e.g., "MH12-AB-4521"
  entryTime DateTime  @default(now())
  exitTime  DateTime?
  fee       Float?
  status    String    @default("ACTIVE") // "ACTIVE", "COMPLETED"
}

model ANPRLog {
  id        String   @id @default(cuid())
  plate     String
  action    String   // "ENTRY", "EXIT"
  zoneId    String
  timestamp DateTime @default(now())
}
