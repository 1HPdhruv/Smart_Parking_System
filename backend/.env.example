# ==============================================================================
# Parker OS Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# Required vars are marked [REQUIRED], optional ones [OPTIONAL].

# [REQUIRED] Neon Postgres — use the POOLED connection string (-pooler suffix)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/parker_os?sslmode=require

# [REQUIRED] For Prisma migrations only — use the DIRECT (non-pooled) string
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/parker_os?sslmode=require

# [REQUIRED] Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-api03-...

# [OPTIONAL] Claude model override (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# [REQUIRED] MQTT broker for ESP32 device communication
MQTT_BROKER_URL=mqtts://broker.hivemq.com:8883
MQTT_USER=
MQTT_PASSWORD=

# [REQUIRED] JWT secret for session tokens (generate a strong random string)
JWT_SECRET=change-me-to-a-random-64-char-string

# [OPTIONAL] JWT token expiry durations
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# [OPTIONAL] CORS origin — set to your Vercel frontend URL in production
CORS_ORIGIN=http://localhost:5173

# [OPTIONAL] Server port (Render sets PORT automatically)
PORT=3001

# [OPTIONAL] Refund review threshold in currency units
# Cancel refunds above this amount require admin review
REFUND_REVIEW_THRESHOLD=500

# [OPTIONAL] Price quote tolerance percentage (e.g., 5 = 5%)
# create_booking rejects if quoted price deviates more than this from fresh quote
PRICE_TOLERANCE_PCT=5
